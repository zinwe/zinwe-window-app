<Project Sdk="WixToolset.Sdk/6.0.2">

  <!--
    Builds ZinweAgent.msi from the self-contained publish output in ..\artifacts\publish\.
    Don't build this directly: run ..\build.ps1, which publishes first.
    Pinned to WiX v6 (v7 adds a mandatory OSMF EULA step; revisit before commercial launch).
  -->
  <PropertyGroup>
    <OutputName>ZinweAgent</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.1.0</ProductVersion>
    <PublishRoot>$(MSBuildThisFileDirectory)..\artifacts\publish\</PublishRoot>
    <DefineConstants>ProductVersion=$(ProductVersion);ServiceDir=$(PublishRoot)service;TrayDir=$(PublishRoot)tray</DefineConstants>
    <!--
      ICE60: SQLite's native e_sqlite3.dll (service only) has a file version but no language in its version
      resource. Harmless for us (language only breaks ties between equal versions); WiX also refuses a made-up
      DefaultLanguage for such a file (WIX1101), so the ICE is suppressed instead.
    -->
    <SuppressIces>ICE60</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <!-- util:ServiceConfig (service crash recovery). -->
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
    <!-- The installer's welcome / install / finish screens (WixUI dialogs; our texts in Package.en-us.wxl). -->
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
  </ItemGroup>

</Project>
