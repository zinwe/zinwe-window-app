<Application x:Class="Zinwe.Agent.Tray.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Light"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!--
            Zinwe tray app v2 design system (prototype board "WinApp"): Theme/Tokens.xaml holds the colour tokens,
            Theme/Controls.xaml the controls. HighContrastTheme lays dark mode or Windows High Contrast over the
            tokens at run time. Geist (Assets/Fonts, SIL OFL) is the typeface.
        -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Tokens.xaml" />
                <ResourceDictionary Source="Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
