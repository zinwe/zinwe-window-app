<Application x:Class="Zinwe.Agent.Tray.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Light"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!--
            Zinwe design system for the Windows app. Tokens mirror the website (zinwe-frontend/src/styles/site.css)
            so the widget, chat and dashboard read as one product:
              - The logo orange #FD6D02 is a FILL colour and always carries ink text (white on orange is only 2.9:1).
              - Orange TEXT uses #B24D01; focus rings/borders #D95D02; soft panels #FFF1E6 with #8A3C00 text.
              - Geist (the website's typeface, OFL, Assets/Fonts) for everything. 6px buttons/chips, 12px cards.
        -->
        <SolidColorBrush x:Key="Zinwe.White" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Zinwe.Paper" Color="#F7F7F4" />
        <SolidColorBrush x:Key="Zinwe.Ink" Color="#0D0D0E" />
        <SolidColorBrush x:Key="Zinwe.Muted" Color="#6E6E6B" />
        <SolidColorBrush x:Key="Zinwe.Line" Color="#E6E6E1" />
        <SolidColorBrush x:Key="Zinwe.LineStrong" Color="#CFCFCA" />
        <SolidColorBrush x:Key="Zinwe.Orange" Color="#FD6D02" />
        <SolidColorBrush x:Key="Zinwe.OrangeDeep" Color="#E86402" />
        <SolidColorBrush x:Key="Zinwe.OrangeStrong" Color="#D95D02" />
        <SolidColorBrush x:Key="Zinwe.OrangeText" Color="#B24D01" />
        <SolidColorBrush x:Key="Zinwe.OrangeTint" Color="#FFF1E6" />
        <SolidColorBrush x:Key="Zinwe.OrangeInk" Color="#8A3C00" />
        <SolidColorBrush x:Key="Zinwe.Ok" Color="#15803D" />
        <SolidColorBrush x:Key="Zinwe.OkTint" Color="#ECFDF3" />
        <SolidColorBrush x:Key="Zinwe.Warn" Color="#B45309" />
        <SolidColorBrush x:Key="Zinwe.WarnTint" Color="#FFF7E6" />
        <SolidColorBrush x:Key="Zinwe.Bad" Color="#C62828" />
        <SolidColorBrush x:Key="Zinwe.BadTint" Color="#FDECEC" />
        <FontFamily x:Key="Zinwe.Font">pack://application:,,,/Zinwe.Agent.Tray;component/Assets/Fonts/#Geist</FontFamily>

        <!-- Keyboard focus: a 2px orange ring with a little offset (never shown for mouse clicks). -->
        <Style x:Key="Zinwe.FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" RadiusX="8" RadiusY="8" StrokeThickness="2"
                                   Stroke="{DynamicResource Zinwe.OrangeStrong}" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary: orange fill, ink text. -->
        <Style x:Key="Zinwe.PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Zinwe.Ink}" />
            <Setter Property="Background" Value="{DynamicResource Zinwe.Orange}" />
            <Setter Property="FontFamily" Value="{StaticResource Zinwe.Font}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Zinwe.FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Zinwe.OrangeDeep}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Zinwe.OrangeStrong}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Zinwe.Line}" />
                                <Setter Property="Foreground" Value="{DynamicResource Zinwe.Muted}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary: white with a hairline border. -->
        <Style x:Key="Zinwe.OutlineButton" TargetType="Button" BasedOn="{StaticResource Zinwe.PrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource Zinwe.White}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource Zinwe.LineStrong}" Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Zinwe.Paper}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Zinwe.Muted}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Zinwe.Muted}" />
                                <Setter TargetName="b" Property="Opacity" Value="0.6" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quiet text button (Cancel, Clear, header actions). -->
        <Style x:Key="Zinwe.HeaderButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Zinwe.Muted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource Zinwe.Font}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Zinwe.FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#EFEFEA" />
                                <Setter Property="Foreground" Value="{DynamicResource Zinwe.Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Reason chip: single choice (RadioButton). Picked = orange tint + orange border. -->
        <Style x:Key="Zinwe.Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Zinwe.Ink}" />
            <Setter Property="Background" Value="{DynamicResource Zinwe.White}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Zinwe.LineStrong}" />
            <Setter Property="FontFamily" Value="{StaticResource Zinwe.Font}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Zinwe.FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="6" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Zinwe.Muted}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Zinwe.OrangeTint}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Zinwe.OrangeStrong}" />
                                <Setter Property="Foreground" Value="{DynamicResource Zinwe.OrangeInk}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The scroll host inside text inputs: content + a slim vertical bar, nothing else. -->
        <ControlTemplate x:Key="Zinwe.InputScroll" TargetType="ScrollViewer">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}" />
                <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Width="8" Margin="4,0,-4,0"
                           Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                           ViewportSize="{TemplateBinding ViewportHeight}"
                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
            </Grid>
        </ControlTemplate>

        <!-- Text input: hairline border, orange border on focus. -->
        <Style x:Key="Zinwe.Input" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Zinwe.Ink}" />
            <Setter Property="Background" Value="{DynamicResource Zinwe.White}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Zinwe.LineStrong}" />
            <Setter Property="FontFamily" Value="{StaticResource Zinwe.Font}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CaretBrush" Value="{DynamicResource Zinwe.Ink}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Zinwe.Orange}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" CornerRadius="6" BorderThickness="1"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <!-- Own minimal ScrollViewer template: the Fluent theme's one offsets the text ~10px right
                                 of where the placeholder sits. All spacing comes from the TextBox's Padding. -->
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                          Template="{StaticResource Zinwe.InputScroll}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Zinwe.Muted}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Zinwe.OrangeStrong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card: white panel, hairline border, 12px radius. -->
        <Style x:Key="Zinwe.Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Zinwe.White}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Zinwe.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- A whole card that opens something (the chat): a real button, so Tab + Enter work too. -->
        <Style x:Key="Zinwe.CardButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Zinwe.Ink}" />
            <Setter Property="FontFamily" Value="{StaticResource Zinwe.Font}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Zinwe.FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="12" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource Zinwe.White}" BorderBrush="{DynamicResource Zinwe.Line}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Zinwe.LineStrong}" />
                                <Setter TargetName="b" Property="Background" Value="#FFFCF9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Zinwe.OrangeTint}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small label above a section ("Good morning"). -->
        <Style x:Key="Zinwe.Eyebrow" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Zinwe.Muted}" />
        </Style>
    </Application.Resources>
</Application>
