<UserControl x:Class="Zinwe.Agent.Tray.ChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:w="clr-namespace:Zinwe.Agent.Tray.Widget">
    <!--
        The chat with the admin, built into the widget. Closed it's one compact bar (unread count + the latest line);
        a click on the bar opens the conversation and the composer below it, another click closes it.
    -->
    <Border Background="{DynamicResource Zinwe.White}" BorderBrush="{DynamicResource Zinwe.Line}" BorderThickness="1"
            CornerRadius="12">
        <StackPanel>
            <!-- The bar: always visible, toggles the chat. -->
            <Button x:Name="HeaderButton" Click="OnToggle" Cursor="Hand" FocusVisualStyle="{StaticResource Zinwe.FocusRing}"
                    AutomationProperties.Name="Messages">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="12" Padding="12,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FFFCF9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="34" Height="34" VerticalAlignment="Center">
                        <Border CornerRadius="9" Background="{DynamicResource Zinwe.OrangeTint}">
                            <Path Width="16" Height="15" Stretch="Uniform" Stroke="{DynamicResource Zinwe.OrangeText}"
                                  StrokeThickness="1.6" StrokeLineJoin="Round"
                                  Data="M3,2 H17 A2,2 0 0 1 19,4 V12 A2,2 0 0 1 17,14 H9 L5,17.5 V14 H3 A2,2 0 0 1 1,12 V4 A2,2 0 0 1 3,2 Z" />
                        </Border>
                        <!-- Unread count, on the icon's corner. -->
                        <Border x:Name="UnreadBadge" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-5,-6,0" MinWidth="18" Height="18" CornerRadius="9" Padding="5,0"
                                Background="{DynamicResource Zinwe.Orange}" BorderBrush="{DynamicResource Zinwe.White}" BorderThickness="2">
                            <TextBlock x:Name="UnreadCount" Text="0" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Zinwe.Ink}" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="Messages" FontSize="13.5" FontWeight="SemiBold" />
                        <TextBlock x:Name="Preview" Text="Chat with your admin" FontSize="12" Margin="0,1,0,0"
                                   Foreground="{DynamicResource Zinwe.Muted}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <!-- Chevron: down when closed, up when open. -->
                    <Path x:Name="Chevron" Grid.Column="2" Data="M0,0 L5,5 L10,0" Stroke="{DynamicResource Zinwe.Muted}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          VerticalAlignment="Center" Margin="0,0,4,0" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="ChevronTurn" Angle="0" />
                        </Path.RenderTransform>
                    </Path>
                </Grid>
            </Button>

            <!-- The chat itself: only while open. -->
            <StackPanel x:Name="Body" Visibility="Collapsed">
                <!-- Connection note (hidden while connected) -->
                <Border x:Name="ConnectionNote" Visibility="Collapsed" Background="{DynamicResource Zinwe.WarnTint}" Padding="14,6">
                    <TextBlock x:Name="ConnectionText" FontSize="12" AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource Zinwe.Warn}" TextWrapping="Wrap" />
                </Border>

                <!-- Conversation (on paper, so white admin bubbles read as cards) -->
                <Border Background="{DynamicResource Zinwe.Paper}" BorderBrush="{DynamicResource Zinwe.Line}" BorderThickness="0,1,0,1"
                        Height="{Binding ConversationHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Grid>
                        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" ScrollChanged="OnScrollChanged">
                            <ItemsControl x:Name="MessageList" Focusable="False" Margin="0,4,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid AutomationProperties.Name="{Binding AccessibleText}">
                                            <!-- Day divider -->
                                            <TextBlock Text="{Binding Text}" Visibility="{Binding SeparatorVisibility}"
                                                       HorizontalAlignment="Center" Margin="0,10,0,4" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Zinwe.Muted}" />
                                            <!-- Bubble: the admin on the left, the member on the right. -->
                                            <StackPanel Visibility="{Binding BubbleVisibility}" HorizontalAlignment="{Binding RowAlignment}"
                                                        MaxWidth="270" Margin="12,3">
                                                <Border Background="{Binding BubbleBrush}" BorderBrush="{Binding BubbleBorder}"
                                                        BorderThickness="1" CornerRadius="12" Padding="11,7" Opacity="{Binding BubbleOpacity}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding ImportanceLabel}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{Binding AccentBrush}" Margin="0,0,0,1"
                                                                   Visibility="{Binding ImportanceVisibility}" />
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                                   TextWrapping="Wrap" Visibility="{Binding TitleVisibility}" />
                                                        <!-- FR-12: links and emails open on click, phone numbers copy; right-click copies any of them. -->
                                                        <TextBlock w:ChatLinks.Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" LineHeight="18"
                                                                   Visibility="{Binding TextVisibility}" />
                                                    </StackPanel>
                                                </Border>
                                                <Button Content="{Binding ReplyLabel}" Visibility="{Binding ReplyVisibility}"
                                                        Style="{StaticResource Zinwe.HeaderButton}" Height="28" Margin="0,4,0,0"
                                                        HorizontalAlignment="Left" Click="OnReply" />
                                                <TextBlock Text="{Binding Stamp}" FontSize="12" Foreground="{DynamicResource Zinwe.Muted}"
                                                           Margin="4,2,4,0" HorizontalAlignment="{Binding RowAlignment}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="28,0" FontSize="12.5"
                                   Foreground="{DynamicResource Zinwe.Muted}"
                                   Text="No messages yet. Your admin's messages show up here, and you can write to them below." />
                    </Grid>
                </Border>

                <!-- Composer -->
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="Input" Style="{StaticResource Zinwe.Input}" MinHeight="38" MaxHeight="96"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 MaxLength="2000" PreviewKeyDown="OnInputKeyDown" TextChanged="OnInputChanged"
                                 ToolTip="Enter to send · Shift+Enter for a new line" AutomationProperties.Name="Message" />
                        <TextBlock x:Name="Placeholder" Text="Write to your admin…" IsHitTestVisible="False"
                                   Foreground="{DynamicResource Zinwe.Muted}" FontSize="13" Margin="11,10,0,0" />
                    </Grid>
                    <Button x:Name="SendButton" Grid.Column="1" Width="38" Height="38" Padding="0" Margin="8,0,0,0"
                            VerticalAlignment="Bottom" Style="{StaticResource Zinwe.PrimaryButton}" IsEnabled="False"
                            Click="OnSend" ToolTip="Send" AutomationProperties.Name="Send">
                        <Path Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M1,1 L19,10 L1,19 L4,10 Z" />
                    </Button>
                </Grid>
                <TextBlock x:Name="SendError" Visibility="Collapsed" FontSize="12" Foreground="{DynamicResource Zinwe.Bad}"
                           AutomationProperties.LiveSetting="Assertive"
                           Margin="14,-4,14,8" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
