<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Tray app controls on the admin panel's theme: hairlines, 12 px cards, 8 px controls, black primary buttons,
        orange for state only (active tab, progress, badges, focus).
          Z.Btn / .Pri / .Dark, Z.BtnSm*, Z.Chip, Z.Seg, Z.Tab, Z.ListItem, Z.LinkBtn, Z.TextAction (plain-text actions:
          Reply, Log, Retry), Z.QuickReply, Z.WinCtl, Z.Input, Z.InputPill, Z.SwitchRow, Z.FilterBtn, Z.TodoBtn, Z.Menu.
        Small controls keep their 30-34 px look but get a 44 px hit area (a transparent frame around the visual).
        Keyboard focus is a 2 px orange ring; the mouse never shows it.
    -->

    <Style x:Key="Z.FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="9" RadiusY="9" StrokeThickness="2"
                               Stroke="{DynamicResource Z.Focus}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Z.FocusRingInset">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="2" RadiusX="8" RadiusY="8" StrokeThickness="2"
                               Stroke="{DynamicResource Z.Focus}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Buttons (.w-btn) ===== -->
    <Style x:Key="Z.Btn" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource Z.Ink}" />
        <Setter Property="Background" Value="{DynamicResource Z.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Z.Line2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource Zinwe.Font}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Z.FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Z.Ink}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Z.Btn.Pri" TargetType="ButtonBase" BasedOn="{StaticResource Z.Btn}">
        <Setter Property="Background" Value="{DynamicResource Z.Inv}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Z.Inv}" />
        <Setter Property="Foreground" Value="{DynamicResource Z.OnInv}" />
    </Style>
    <Style x:Key="Z.Btn.Dark" TargetType="ButtonBase" BasedOn="{StaticResource Z.Btn}">
        <Setter Property="Background" Value="{DynamicResource Z.Inv}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Z.Inv}" />
        <Setter Property="Foreground" Value="{DynamicResource Z.OnInv}" />
    </Style>

    <!-- Small button: 34 px look, 44 px hit area. -->
    <Style x:Key="Z.BtnSm" TargetType="ButtonBase" BasedOn="{StaticResource Z.Btn}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid Background="Transparent">
                        <Border x:Name="b" CornerRadius="8" MinHeight="34" VerticalAlignment="Center"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Z.Ink}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Z.BtnSm.Pri" TargetType="ButtonBase" BasedOn="{StaticResource Z.BtnSm}">
        <Setter Property="Background" Value="{DynamicResource Z.Inv}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Z.Inv}" />
        <Setter Property="Foreground" Value="{DynamicResource Z.OnInv}" />
    </Style>
    <Style x:Key="Z.BtnSm.Dark" TargetType="ButtonBase" BasedOn="{StaticResource Z.BtnSm}">
        <Setter Property="Background" Value="{DynamicResource Z.Inv}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Z.Inv}" />
        <Setter Property="Foreground" Value="{DynamicResource Z.OnInv}" />
    </Style>

    <!-- A bare icon / text button (Back, ×, the chevron frame). -->
    <Style x:Key="Z.IconBtn" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource Z.Ink3}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{DynamicResource Zinwe.Font}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Z.FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#1F7F7F7F" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .lnk: underlined orange text, 40+ px tall hit area. -->
    <Style x:Key="Z.LinkBtn" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource Z.Link}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{DynamicResource Zinwe.Font}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Z.FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid Background="Transparent">
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextDecorations="Underline" VerticalAlignment="Center"
                                   HorizontalAlignment="Left" Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain text actions under a message or on a task: Reply, Log, Retry, Delete. Text first; the hit area is invisible. -->
    <Style x:Key="Z.TextAction" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource Z.Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{DynamicResource Zinwe.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Margin" Value="-4,-3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Z.FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid Background="Transparent">
                        <TextBlock x:Name="t" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center"
                                   Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Z.Ink}" />
                            <Setter TargetName="t" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Composer send: 32 px, ink when there is something to send. -->
    <Style x:Key="Z.SendBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Z.OnInv}" />
        <Setter Property="Background" Value="{DynamicResource Z.Inv}" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Z.FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}" ClipToBounds="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Z.Fill}" />
                <Setter Property="Foreground" Value="{DynamicResource Z.Muted}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- "1 new message": floats over the chat while the member reads older messages. -->
    <Style x:Key="Z.JumpBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Z.OnInv}" />
        <Setter Property="Background" Value="{DynamicResource Z.Inv}" />
        <Setter Property="FontFamily" Value="{DynamicResource Zinwe.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Z.FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.18" Direction="270" Color="#141210" />
                        </Border.Effect>
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Single choice (reasons, due): 30 px look, 44 px hit area; on = ink fill. -->
    <Style x:Key="Z.Chip" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Z.Ink}" />
        <Setter Property="Background" Value="{DynamicResource Z.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Z.Line2}" />
        <Setter Property="FontFamily" Value="{DynamicResource Zinwe.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Z.FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="b" CornerRadius="8" MinHeight="30" VerticalAlignment="Center" BorderThickness="1"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Z.Ink}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Z.Inv}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Z.Inv}" />
                            <Setter Property="Foreground" Value="{DynamicResource Z.OnInv}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Task filters: Status / Date / From open a menu, 34 px look with a 44 px hit area. On = the admin panel's ink border. -->
    <Style x:Key="Z.FilterBtn" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Z.Ink2}" />
        <Setter Property="Background" Value="{DynamicResource Z.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Z.Line2}" />
        <Setter Property="FontFamily" Value="{DynamicResource Zinwe.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,0,6,0" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Z.FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="b" CornerRadius="8" MinHeight="34" VerticalAlignment="Center" BorderThickness="1"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Z.Ink}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Z.Ink}" />
                            <Setter Property="Foreground" Value="{DynamicResource Z.Ink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Todo: the one filter that is a switch, not a menu. On = ink fill. -->
    <Style x:Key="Z.TodoBtn" TargetType="ToggleButton" BasedOn="{StaticResource Z.FilterBtn}">
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Z.Ink}" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Z.Inv}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Z.Inv}" />
                <Setter Property="Foreground" Value="{DynamicResource Z.OnInv}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The filters' menu. Keyboard arrows come with ContextMenu. Tag = the count on the right. -->
    <Style x:Key="Z.Menu" TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{DynamicResource Zinwe.Font}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="0,0,12,16" Width="176" Padding="4" CornerRadius="10" BorderThickness="1"
                            Background="{DynamicResource Z.Surface}" BorderBrush="{DynamicResource Z.Line}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.18" Direction="270" Color="#141210" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Z.MenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Z.Ink}" />
        <Setter Property="FontFamily" Value="{DynamicResource Zinwe.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="b" CornerRadius="6" MinHeight="34" Padding="8,0" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path x:Name="tick" Data="M5 13l4 4 10-10" Stroke="{DynamicResource Z.Link}" StrokeThickness="3" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Left"
                                  VerticalAlignment="Center" Visibility="Hidden" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="False" />
                            <TextBlock Grid.Column="2" Text="{TemplateBinding Tag}" FontSize="12" Foreground="{DynamicResource Z.Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Z.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .seg: segmented control (Text size, Policies tabs). -->
    <Style x:Key="Z.Seg" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Z.Ink3}" />
        <Setter Property="FontFamily" Value="{DynamicResource Zinwe.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Z.FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Z.Inv}" />
                            <Setter Property="Foreground" Value="{DynamicResource Z.OnInv}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .tab: bottom tab bar. Tag = icon path data. -->
    <Style x:Key="Z.Tab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Z.Muted}" />
        <Setter Property="FontFamily" Value="{DynamicResource Zinwe.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Z.FocusRingInset}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path x:Name="ic" Width="20" Height="20" Stretch="Uniform" StrokeThickness="1.8" HorizontalAlignment="Center"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stroke="{TemplateBinding Foreground}"
                                  Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter HorizontalAlignment="Center" Margin="0,3,0,0" RecognizesAccessKey="False" />
                        </StackPanel>
                        <Border x:Name="bar" Height="2" Margin="24,-1,24,0" VerticalAlignment="Top" Background="{DynamicResource Z.Orange}" Visibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Z.Ink}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Z.Ink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .li: a full-width list row inside a card. -->
    <Style x:Key="Z.ListItem" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource Z.Ink}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Z.LineSoft}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="FontFamily" Value="{DynamicResource Zinwe.Font}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Z.FocusRingInset}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                          RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Z.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- role=switch rows: label on the left, a 40 x 24 track on the right. -->
    <Style x:Key="Z.SwitchRow" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Z.Ink}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{DynamicResource Zinwe.Font}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Z.FocusRingInset}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Z.LineSoft}"
                            BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" Margin="0,0,12,0" />
                            <Border x:Name="track" Grid.Column="1" Width="40" Height="24" CornerRadius="12" Padding="2"
                                    Background="{DynamicResource Z.Off}" VerticalAlignment="Center">
                                <Ellipse x:Name="knob" Width="20" Height="20" Fill="White" HorizontalAlignment="Left">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.25" Direction="270" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Z.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource Z.Progress}" />
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quick reply: 30 px look, 36 px hit area. -->
    <Style x:Key="Z.QuickReply" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource Z.Ink}" />
        <Setter Property="Background" Value="{DynamicResource Z.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Z.Line2}" />
        <Setter Property="FontFamily" Value="{DynamicResource Zinwe.Font}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Z.FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid Background="Transparent">
                        <Border x:Name="b" CornerRadius="8" MinHeight="30" VerticalAlignment="Center" BorderThickness="1"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Z.Ink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .win-ctl: title bar minimize / close (both tuck Zinwe away to the taskbar). -->
    <Style x:Key="Z.WinCtl" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Z.Ink}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Z.FocusRingInset}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#297F7F7F" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Z.WinClose" TargetType="Button" BasedOn="{StaticResource Z.WinCtl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#C42B1C" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Work menu rows (role=menuitem). -->
    <Style x:Key="Z.MenuRow" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Z.Ink}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{DynamicResource Zinwe.Font}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Z.FocusRingInset}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Z.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text inputs. Tag = placeholder text (shown while empty). -->
    <ControlTemplate x:Key="Zinwe.InputScroll" TargetType="ScrollViewer">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}" />
            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Width="8" Margin="4,0,-4,0"
                       Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                       ViewportSize="{TemplateBinding ViewportHeight}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="Z.Input" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Z.Ink}" />
        <Setter Property="Background" Value="{DynamicResource Z.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Z.Line2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource Zinwe.Font}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{DynamicResource Z.Ink}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Z.Orange}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" CornerRadius="8" BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                        <Grid Margin="{TemplateBinding Padding}">
                            <TextBlock x:Name="ph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource Z.Muted}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsHitTestVisible="False"
                                       Visibility="Collapsed" Margin="2,0,0,0" TextTrimming="CharacterEllipsis" />
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Template="{StaticResource Zinwe.InputScroll}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Z.Muted}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Z.Focus}" />
                            <Setter TargetName="b" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- The note field in the reason sheet. -->
    <Style x:Key="Z.InputPill" TargetType="TextBox" BasedOn="{StaticResource Z.Input}">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" CornerRadius="8" BorderThickness="{TemplateBinding BorderThickness}"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                        <Grid Margin="{TemplateBinding Padding}">
                            <TextBlock x:Name="ph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource Z.Muted}"
                                       VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" Margin="2,0,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Template="{StaticResource Zinwe.InputScroll}"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Z.Focus}" />
                            <Setter TargetName="b" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cards and text styles. -->
    <Style x:Key="Z.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Z.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Z.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="Z.Note" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Z.Fill}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style x:Key="Z.Lbl" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Z.Muted}" />
    </Style>
    <Style x:Key="Z.Sub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Z.Muted}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Z.H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="Z.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19.5" />
        <Setter Property="Foreground" Value="{DynamicResource Z.Ink2}" />
    </Style>
    <Style x:Key="Z.Scroll" TargetType="ScrollViewer">
        <Style.Resources>
            <!-- A thin bar with no arrows, so it doesn't crowd the phone-width window. -->
            <Style TargetType="ScrollBar">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Width" Value="8" />
                <Setter Property="MinWidth" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb Focusable="False">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border CornerRadius="3" Margin="1,2" Background="{DynamicResource Z.Line2}" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- ===== Legacy keys (FeedbackPanel and older code) on the v2 look ===== -->
    <Style x:Key="Zinwe.FocusRing" BasedOn="{StaticResource Z.FocusRing}" />
    <Style x:Key="Zinwe.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Z.Btn.Pri}" />
    <Style x:Key="Zinwe.OutlineButton" TargetType="Button" BasedOn="{StaticResource Z.Btn}" />
    <Style x:Key="Zinwe.HeaderButton" TargetType="Button" BasedOn="{StaticResource Z.IconBtn}">
        <Setter Property="Foreground" Value="{DynamicResource Z.Ink3}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style x:Key="Zinwe.Chip" TargetType="RadioButton" BasedOn="{StaticResource Z.Chip}" />
    <Style x:Key="Zinwe.Input" TargetType="TextBox" BasedOn="{StaticResource Z.Input}" />
    <Style x:Key="Zinwe.Card" TargetType="Border" BasedOn="{StaticResource Z.Card}">
        <Setter Property="Padding" Value="14" />
    </Style>
    <Style x:Key="Zinwe.Eyebrow" TargetType="TextBlock" BasedOn="{StaticResource Z.Lbl}" />
</ResourceDictionary>
