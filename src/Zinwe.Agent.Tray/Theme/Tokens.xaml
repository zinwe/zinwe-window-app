<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Tray app v2 design tokens. Every brush is used as a DynamicResource, so HighContrastTheme can swap them for
        dark mode (Settings > Look) and for Windows High Contrast without touching a view.

        Colour rule v1.3.2 (owner, 31 Oct): white, black, orange only.
          ground/surface #FFFFFF · surface-2 #F5F5F5 · line #E5E5E5 · line-2 #D4D4D4
          ink #141210 · ink-2 #404040 · ink-3 #6B6B6B
          accent #F26A0A · accent-hover #E05E04 · accent-text #A84505 · accent-tint #FDEBDC
          (+ accent-soft #FFF6EE / accent-line #F3CFAE for soft panels: the NOW card, the break strip)
          danger #C0331C / #FCE8E4 · ok #17663F / #E3F4EA (status only, always with a word or an icon).
        No decorative green, blue, purple or amber: amber states (break, offline, warning) are orange,
        blue states (waiting, admin notes, chat tile) are grey. Key names stay (Warn*, Info*) so views and
        the High Contrast map don't change; their values follow the rule.

        Brand rules (the admin panel's): primary buttons are ink, not orange. Orange #F26A0A marks state only: the active
        tab, progress, badges, switches, focus rings; as a fill it always carries ink text #141210, never white.
        Orange as text uses Z.Link (#A84505). The member's chat bubbles use the tint.
    -->

    <!-- Surfaces and lines -->
    <SolidColorBrush x:Key="Z.Bg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Z.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Z.Surface2" Color="#F5F5F5" />
    <SolidColorBrush x:Key="Z.Fill" Color="#F5F5F5" />
    <SolidColorBrush x:Key="Z.Line" Color="#E5E5E5" />
    <SolidColorBrush x:Key="Z.LineSoft" Color="#E5E5E5" />
    <SolidColorBrush x:Key="Z.Line2" Color="#D4D4D4" />
    <SolidColorBrush x:Key="Z.Hover" Color="#F5F5F5" />

    <!-- Text -->
    <SolidColorBrush x:Key="Z.Ink" Color="#141210" />
    <SolidColorBrush x:Key="Z.Ink2" Color="#404040" />
    <SolidColorBrush x:Key="Z.Ink3" Color="#404040" />
    <SolidColorBrush x:Key="Z.Muted" Color="#6B6B6B" />
    <SolidColorBrush x:Key="Z.Link" Color="#A84505" />
    <SolidColorBrush x:Key="Z.Inv" Color="#141210" />
    <SolidColorBrush x:Key="Z.OnInv" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Z.WarnText" Color="#A84505" />
    <SolidColorBrush x:Key="Z.RedText" Color="#C0331C" />

    <!-- Task state text (cards) -->
    <SolidColorBrush x:Key="Z.StDoing" Color="#A84505" />
    <SolidColorBrush x:Key="Z.StWait" Color="#404040" />
    <SolidColorBrush x:Key="Z.StDone" Color="#17663F" />

    <!-- Soft panels -->
    <SolidColorBrush x:Key="Z.AccentSoft" Color="#FFF6EE" />
    <SolidColorBrush x:Key="Z.AccentLine" Color="#F3CFAE" />
    <SolidColorBrush x:Key="Z.WarnSoft" Color="#FFF6EE" />
    <SolidColorBrush x:Key="Z.WarnLine" Color="#F3CFAE" />
    <SolidColorBrush x:Key="Z.Snack" Color="#141210" />
    <SolidColorBrush x:Key="Z.TabOn" Color="#FDEBDC" />

    <!-- Brand fills, tints and status (dark values live in HighContrastTheme.Dark) -->
    <SolidColorBrush x:Key="Z.Orange" Color="#F26A0A" />
    <SolidColorBrush x:Key="Z.Focus" Color="#F26A0A" />
    <SolidColorBrush x:Key="Z.OnOrange" Color="#141210" />
    <SolidColorBrush x:Key="Z.OkTint" Color="#E3F4EA" />
    <SolidColorBrush x:Key="Z.Ok" Color="#17663F" />
    <SolidColorBrush x:Key="Z.OkFill" Color="#17663F" />
    <!-- Switch "on" track and the NOW card's step bar: orange (they were green, decorative). -->
    <SolidColorBrush x:Key="Z.Progress" Color="#F26A0A" />
    <SolidColorBrush x:Key="Z.ProgressTrack" Color="#F3CFAE" />
    <SolidColorBrush x:Key="Z.WarnTint" Color="#FDEBDC" />
    <SolidColorBrush x:Key="Z.Warn" Color="#A84505" />
    <SolidColorBrush x:Key="Z.WarnInk" Color="#A84505" />
    <SolidColorBrush x:Key="Z.InfoTint" Color="#F5F5F5" />
    <SolidColorBrush x:Key="Z.Info" Color="#404040" />
    <SolidColorBrush x:Key="Z.InfoInk" Color="#141210" />
    <SolidColorBrush x:Key="Z.OrangeTint" Color="#FDEBDC" />
    <SolidColorBrush x:Key="Z.OrangeInk" Color="#A84505" />
    <SolidColorBrush x:Key="Z.SoonTint" Color="#FDEBDC" />
    <SolidColorBrush x:Key="Z.RedTint" Color="#FCE8E4" />
    <SolidColorBrush x:Key="Z.RedInk" Color="#C0331C" />
    <SolidColorBrush x:Key="Z.Off" Color="#6B6B6B" />
    <SolidColorBrush x:Key="Z.Dim" Color="#59141210" />
    <SolidColorBrush x:Key="Z.SnackAction" Color="#FF8A3D" />

    <!-- Legacy keys (v1 widget, FeedbackPanel, ChatRow / NotificationRow): mapped onto the v2 palette. -->
    <SolidColorBrush x:Key="Zinwe.White" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Zinwe.Paper" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Zinwe.Ink" Color="#141210" />
    <SolidColorBrush x:Key="Zinwe.Muted" Color="#6B6B6B" />
    <SolidColorBrush x:Key="Zinwe.Line" Color="#E5E5E5" />
    <SolidColorBrush x:Key="Zinwe.LineStrong" Color="#D4D4D4" />
    <SolidColorBrush x:Key="Zinwe.Orange" Color="#F26A0A" />
    <SolidColorBrush x:Key="Zinwe.OrangeDeep" Color="#E05E04" />
    <SolidColorBrush x:Key="Zinwe.OrangeStrong" Color="#F26A0A" />
    <SolidColorBrush x:Key="Zinwe.OrangeText" Color="#A84505" />
    <SolidColorBrush x:Key="Zinwe.OrangeTint" Color="#FDEBDC" />
    <SolidColorBrush x:Key="Zinwe.OrangeInk" Color="#A84505" />
    <SolidColorBrush x:Key="Zinwe.Ok" Color="#17663F" />
    <SolidColorBrush x:Key="Zinwe.OkTint" Color="#E3F4EA" />
    <SolidColorBrush x:Key="Zinwe.Warn" Color="#A84505" />
    <SolidColorBrush x:Key="Zinwe.WarnTint" Color="#FDEBDC" />
    <SolidColorBrush x:Key="Zinwe.Bad" Color="#C0331C" />
    <SolidColorBrush x:Key="Zinwe.BadTint" Color="#FCE8E4" />

    <!-- The official logo (brand kit): the wordmark swaps to its light version in dark mode (HighContrastTheme). -->
    <BitmapImage x:Key="Z.Wordmark" UriSource="pack://application:,,,/Zinwe.Agent.Tray;component/Assets/zinwe-logo.png" />
    <BitmapImage x:Key="Z.Mark" UriSource="pack://application:,,,/Zinwe.Agent.Tray;component/Assets/zinwe-mark.png" />

    <FontFamily x:Key="Zinwe.Font">pack://application:,,,/Zinwe.Agent.Tray;component/Assets/Fonts/#Geist</FontFamily>
    <!-- Times, IDs and versions. The board uses Geist Mono; Windows 11 ships Cascadia Mono, so no extra font file. -->
    <FontFamily x:Key="Z.Mono">Cascadia Mono, Consolas</FontFamily>
</ResourceDictionary>
