<UserControl x:Class="Zinwe.Agent.Tray.IssuePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        F-13: the member tells the Zinwe team something isn't working. What happened, optionally a screenshot of this
        window (shown before it's sent), Send. Like Send feedback, it goes to the Zinwe team through the agent, not to
        their company.
    -->
    <Grid>
        <StackPanel x:Name="Form">
            <TextBox x:Name="Description" Style="{StaticResource Z.Input}" MaxLength="2000" Padding="12,9" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalContentAlignment="Top" MinHeight="96" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                     SpellCheck.IsEnabled="True" Tag="What happened? What did you expect?"
                     AutomationProperties.Name="What went wrong" TextChanged="OnTextChanged" />
            <CheckBox x:Name="Attach" Margin="0,10,0,0" Cursor="Hand" FocusVisualStyle="{StaticResource Z.FocusRing}"
                      Checked="OnAttachChanged" Unchecked="OnAttachChanged" AutomationProperties.Name="Attach a screenshot of this window">
                <CheckBox.Template>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" MinHeight="36">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5" VerticalAlignment="Center"
                                    BorderBrush="{DynamicResource Z.Line2}" Background="{DynamicResource Z.Surface}">
                                <Path x:Name="tick" Data="M2,6.5 L4.5,9 L10,3.5" Stroke="{DynamicResource Z.OnInv}" StrokeThickness="2" Width="12" Height="12"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="Attach a screenshot of this window" Margin="10,0,0,0" VerticalAlignment="Center"
                                       FontSize="13" Foreground="{DynamicResource Z.Ink}" TextWrapping="Wrap" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource Z.Inv}" />
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Z.Inv}" />
                                <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Z.Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </CheckBox.Template>
            </CheckBox>
            <Border x:Name="ShotFrame" Margin="28,6,0,0" HorizontalAlignment="Left" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource Z.Line}" Visibility="Collapsed">
                <Image x:Name="Shot" MaxHeight="150" Stretch="Uniform" AutomationProperties.Name="The screenshot that will be sent" />
            </Border>
            <TextBlock x:Name="ShotNote" Margin="28,4,0,0" FontSize="12" Foreground="{DynamicResource Z.Muted}" TextWrapping="Wrap"
                       Visibility="Collapsed" Text="This is what the Zinwe team sees. Untick it if something private shows." />
            <TextBlock x:Name="Error" Margin="0,8,0,0" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource Z.RedText}"
                       TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SendButton" Style="{StaticResource Z.Btn.Pri}" Content="Send to the Zinwe team" MinHeight="44" IsEnabled="False"
                        Click="OnSend" />
                <Button Grid.Column="1" Style="{StaticResource Z.Btn}" Content="Cancel" MinHeight="44" Margin="8,0,0,0" Click="OnCancel" />
            </Grid>
        </StackPanel>
        <StackPanel x:Name="Thanks" Visibility="Collapsed">
            <TextBlock Text="Thanks for telling us." FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource Z.Ink}" />
            <TextBlock FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,10" Foreground="{DynamicResource Z.Muted}"
                       Text="Zinwe sends it to our team within a few seconds (when you're back online, if you're offline now). We read every report." />
            <Button Content="Close" Style="{StaticResource Z.Btn}" MinHeight="44" Click="OnCancel" />
        </StackPanel>
    </Grid>
</UserControl>
