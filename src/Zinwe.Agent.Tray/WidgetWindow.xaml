<Window x:Class="Zinwe.Agent.Tray.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zinwe"
        Width="380" Height="720"
        WindowStyle="None" ResizeMode="CanMinimize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        PreviewKeyDown="OnWindowKeyDown"
        Background="{DynamicResource Z.Bg}"
        BorderBrush="{DynamicResource Z.Line2}" BorderThickness="1"
        FontFamily="{DynamicResource Zinwe.Font}" FontSize="13.5"
        Foreground="{DynamicResource Z.Ink}">

    <!--
        Zinwe for Windows, tray app v2 (prototype board "WinApp"): a phone-width window that opens above the taskbar,
        bottom right, and minimizes to its taskbar icon. Bottom tabs Home · Chat · Tasks · Me; pushed screens
        (My time, Policies & terms, Settings, Notifications, Help) with a Back arrow; reasons, task questions and the
        profile photo as bottom sheets. The views (Views/*) render from one TrayModel.
    -->
    <Window.Resources>
        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="30,5,0,0" />
            <Setter Property="MinWidth" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Background" Value="{DynamicResource Z.Orange}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: the official Zinwe wordmark, minimize and close (both keep Zinwe running in the taskbar). -->
        <Grid Background="{DynamicResource Z.Fill}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                <Image x:Name="TitleLogo" Source="{DynamicResource Z.Wordmark}" Height="14" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" AutomationProperties.Name="Zinwe" />
                <TextBlock x:Name="TitleText" FontSize="12" Margin="6,0,0,0" Foreground="{DynamicResource Z.Ink2}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource Z.WinCtl}" WindowChrome.IsHitTestVisibleInChrome="True"
                    AutomationProperties.Name="Minimize" ToolTip="Minimize" Click="OnTuck">
                <Path Data="M0,5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"
                      Width="10" Height="10" />
            </Button>
            <Button Grid.Column="2" Style="{StaticResource Z.WinClose}" WindowChrome.IsHitTestVisibleInChrome="True"
                    AutomationProperties.Name="Close" ToolTip="Close (Zinwe keeps running in the taskbar)" Click="OnTuck">
                <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1" Width="10" Height="10" />
            </Button>
        </Grid>

        <!-- Header: Back or the official Zinwe mark, the screen title with one useful line under it, the work pill + menu. -->
        <Border Grid.Row="1" Height="56" Margin="0,0,0,8" Background="{DynamicResource Z.Bg}"
                BorderBrush="{DynamicResource Z.Line}" BorderThickness="0,0,0,1" Padding="14,0,12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Style="{StaticResource Z.IconBtn}" Width="40" Height="40" Margin="-8,0,6,0"
                        AutomationProperties.Name="Back" ToolTip="Back" Click="OnBack" Visibility="Collapsed">
                    <Path Data="M7,1 L1,7 L7,13" Stroke="{DynamicResource Z.Ink}" StrokeThickness="2" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Button>
                <Image x:Name="HeaderMark" Source="{DynamicResource Z.Mark}" Width="28" Height="28" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,10,0" VerticalAlignment="Center"
                       AutomationProperties.Name="Zinwe" />
                <!-- FR-44: the member's picture takes the mark's place once they have one. -->
                <ContentControl x:Name="HeaderPicture" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center"
                                Focusable="False" Visibility="Collapsed" AutomationProperties.Name="Your picture" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ScreenTitle" Text="Home" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <StackPanel x:Name="StatusRow" Orientation="Horizontal" Margin="0,1,0,0">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusLine" FontSize="12" Foreground="{DynamicResource Z.Ink3}" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </StackPanel>
                <!-- The compact work pill (every screen but Home): time + a small menu. -->
                <Button x:Name="MiniPill" Grid.Column="2" Click="OnMiniPill" Cursor="Hand" Visibility="Collapsed"
                        FocusVisualStyle="{StaticResource Z.FocusRing}" MinHeight="44">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Border x:Name="b" MinHeight="34" CornerRadius="17" Padding="11,0,10,0" VerticalAlignment="Center"
                                        Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="MiniDot" Width="9" Height="9" VerticalAlignment="Center" />
                        <TextBlock x:Name="MiniText" FontSize="13" FontWeight="Bold" Margin="7,0,0,0" VerticalAlignment="Center" />
                        <Path x:Name="MiniChevron" Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Z.Muted}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="7,1,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Popup x:Name="WorkMenu" Grid.Column="2" PlacementTarget="{Binding ElementName=MiniPill}" Placement="Custom"
                       StaysOpen="False" AllowsTransparency="True" Closed="OnWorkMenuClosed">
                    <Border Width="236" Margin="0,0,8,12" Background="{DynamicResource Z.Surface}" BorderBrush="{DynamicResource Z.Line}"
                            BorderThickness="1" CornerRadius="14" Padding="6" KeyDown="OnWorkMenuKey">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.18" Direction="270" Color="#17140F" />
                        </Border.Effect>
                        <StackPanel x:Name="WorkMenuItems" KeyboardNavigation.DirectionalNavigation="Cycle">
                            <WrapPanel Margin="8,6,8,8">
                                <Border x:Name="MenuPill" CornerRadius="10" Padding="9,2" Margin="0,0,8,0">
                                    <TextBlock x:Name="MenuPillText" FontSize="12" FontWeight="Bold" />
                                </Border>
                                <TextBlock x:Name="MenuSince" FontSize="12" Foreground="{DynamicResource Z.Muted}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </WrapPanel>
                            <Border Height="1" Background="{DynamicResource Z.LineSoft}" Margin="0,0,0,2" />
                            <Button x:Name="MenuBreak" Style="{StaticResource Z.MenuRow}" FontWeight="Bold" Content="Take a break" Click="OnMenuBreak" />
                            <Button x:Name="MenuEndBreak" Style="{StaticResource Z.MenuRow}" FontWeight="Bold" Content="End break" Click="OnMenuEndBreak" />
                            <Button x:Name="MenuEnd" Style="{StaticResource Z.MenuRow}" Content="End day" Click="OnMenuEnd" />
                            <Button Style="{StaticResource Z.MenuRow}" Content="My time today" Click="OnMenuTime" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <!-- Everything under the header. -->
        <Grid Grid.Row="2">
            <ContentControl x:Name="OnboardHost" Focusable="False" />

            <Grid x:Name="AppArea">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="62" />
                </Grid.RowDefinitions>

                <!-- The work strip (Home only): pill, hours and minutes, the buttons that make sense now. -->
                <Border x:Name="Strip" Margin="12,0,12,10" CornerRadius="14" Padding="12,4,4,4" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="StripPill" CornerRadius="10" Padding="9,2" VerticalAlignment="Center">
                            <TextBlock x:Name="StripPillText" FontSize="12" FontWeight="Bold" />
                        </Border>
                        <TextBlock x:Name="BigTime" Grid.Column="1" FontFamily="{DynamicResource Z.Mono}" FontSize="18" FontWeight="Bold"
                                   Margin="8,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button x:Name="StartDayButton" Style="{StaticResource Z.BtnSm.Pri}" Content="Start day" Click="OnStartDay" />
                            <Button x:Name="BreakButton" Style="{StaticResource Z.BtnSm}" Content="Take a break" Click="OnAskBreak" />
                            <Button x:Name="EndDayButton" Style="{StaticResource Z.BtnSm}" Content="End day" Margin="6,0,0,0" Click="OnAskOut" />
                            <Button x:Name="EndBreakButton" Style="{StaticResource Z.BtnSm.Dark}" Content="End break" Click="OnEndBreak" />
                            <Button x:Name="StartAgainButton" Style="{StaticResource Z.BtnSm}" Content="Start again" Click="OnStartDay" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Banners: Zinwe isn't running, offline. -->
                <StackPanel Grid.Row="1">
                    <Border x:Name="NotRunningBanner" Margin="12,0,12,8" CornerRadius="12" Padding="12,10" Background="{DynamicResource Z.RedTint}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="NotRunningTitle" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Z.RedInk}" />
                            <TextBlock x:Name="NotRunningBody" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource Z.RedInk}"
                                       AutomationProperties.LiveSetting="Assertive" />
                            <Button x:Name="RetryButton" Style="{StaticResource Z.BtnSm}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                    Content="Try again" Click="OnRetry" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="OfflineBanner" Margin="12,0,12,8" CornerRadius="10" Padding="12,8" Background="{DynamicResource Z.Snack}"
                            Visibility="Collapsed">
                        <TextBlock x:Name="OfflineText" FontSize="12" Foreground="White" TextWrapping="Wrap" LineHeight="17"
                                   AutomationProperties.LiveSetting="Polite" />
                    </Border>
                </StackPanel>

                <!-- The task in focus (Home only): NOW / UP NEXT. -->
                <Border x:Name="FocusCard" Grid.Row="2" Margin="12,0,12,10" CornerRadius="14" Padding="12,9,10,10" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <TextBlock x:Name="FocusKicker" Style="{StaticResource Z.Lbl}" />
                            <TextBlock x:Name="FocusDue" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="FocusTitle" Click="OnFocusOpen" Cursor="Hand" FocusVisualStyle="{StaticResource Z.FocusRing}" Foreground="{DynamicResource Z.Ink}"
                                    MinHeight="36" HorizontalContentAlignment="Left">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Background="Transparent">
                                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontWeight="Bold"
                                                       FontSize="13.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="FocusCta" Grid.Column="1" Margin="8,0,0,0" Click="OnFocusRun" />
                        </Grid>
                        <Grid x:Name="FocusSteps" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Height="5" CornerRadius="3" Background="{DynamicResource Z.Fill}" VerticalAlignment="Center" ClipToBounds="True">
                                <Border x:Name="FocusBar" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource Z.OkFill}" />
                            </Border>
                            <TextBlock x:Name="FocusStepsText" Grid.Column="1" FontFamily="{DynamicResource Z.Mono}" FontSize="12"
                                       Foreground="{DynamicResource Z.Muted}" Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- The screens; the snack bar and the bottom sheet sit over them. -->
                <Grid x:Name="ScreenHost" Grid.Row="3">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="TextScale" ScaleX="1" ScaleY="1" />
                    </Grid.LayoutTransform>
                    <!-- The views (Views/*) are added here in code: no XAML reference to this assembly's own types, so the
                         markup compile needs no temporary assembly (that pass raced on obj\ and failed with CS2001). -->
                    <Grid x:Name="ScreensHost" />

                    <!-- Snack bar -->
                    <Border x:Name="SnackBar" VerticalAlignment="Bottom" Margin="12" CornerRadius="12" Padding="12,4,12,4"
                            Background="{DynamicResource Z.Snack}" Visibility="Collapsed" Panel.ZIndex="4">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.5" Direction="270" />
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SnackText" FontSize="12.5" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"
                                       LineHeight="17" Margin="0,6" AutomationProperties.LiveSetting="Polite" />
                            <StackPanel x:Name="SnackActions" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" />
                        </Grid>
                    </Border>

                    <ContentControl x:Name="SheetSlot" Panel.ZIndex="5" Focusable="False" />
                </Grid>

                <!-- Bottom tabs. -->
                <Border Grid.Row="4" Background="{DynamicResource Z.Surface}" BorderBrush="{DynamicResource Z.Line}" BorderThickness="0,1,0,0">
                    <Grid x:Name="TabBar" AutomationProperties.Name="Zinwe sections">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="TabHome" Style="{StaticResource Z.Tab}" GroupName="tabs" Content="Home" Checked="OnTab"
                                     Tag="M3,11 L12,4 L21,11 V20 H5 V11 M10,20 V15 H14 V20" />
                        <RadioButton x:Name="TabChat" Grid.Column="1" Style="{StaticResource Z.Tab}" GroupName="tabs" Content="Chat" Checked="OnTab"
                                     Tag="M21,12 A8,8 0 0 1 9.4,19.1 L4,20 L5,15.4 A8,8 0 1 1 21,12 Z" />
                        <RadioButton x:Name="TabTasks" Grid.Column="2" Style="{StaticResource Z.Tab}" GroupName="tabs" Content="Tasks" Checked="OnTab"
                                     Tag="M5,4 H19 A1,1 0 0 1 20,5 V19 A1,1 0 0 1 19,20 H5 A1,1 0 0 1 4,19 V5 A1,1 0 0 1 5,4 Z M8.5,12.5 L11,15 L15.5,10" />
                        <RadioButton x:Name="TabMe" Grid.Column="3" Style="{StaticResource Z.Tab}" GroupName="tabs" Content="Me" Checked="OnTab"
                                     Tag="M12,12 A4,4 0 1 0 12,4 A4,4 0 0 0 12,12 Z M4,21 A8,8 0 0 1 20,21" />
                        <Border x:Name="BadgeChat" Grid.Column="1" Style="{StaticResource BadgeStyle}" />
                        <Border x:Name="BadgeTasks" Grid.Column="2" Style="{StaticResource BadgeStyle}" />
                        <Border x:Name="BadgeMe" Grid.Column="3" Style="{StaticResource BadgeStyle}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>

</Window>
