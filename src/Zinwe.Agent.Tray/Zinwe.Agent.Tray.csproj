<Project Sdk="Microsoft.NET.Sdk">

  <!-- Per-user tray app: status, consent and alerts. Talks only to the local service, never to the backend. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for System.Windows.Forms.NotifyIcon; WPF has no tray icon of its own. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Application.ThemeMode (built-in Fluent theme) is still flagged experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- Required by [LibraryImport] source-generated P/Invoke (DestroyIcon). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Real Zinwe mark as the window/taskbar/exe icon. -->
    <ApplicationIcon>Assets\zinwe.ico</ApplicationIcon>
    <!-- File description = the app name Windows shows on the tray's notifications (else "Zinwe.Agent.Tray"). -->
    <AssemblyTitle>Zinwe</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms + WPF both define Application, MessageBox, etc. Keep WPF as the default namespace. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- The brand mark (orange Z on white): shown in the widget; also the source for the tray icon. -->
    <Resource Include="Assets\zinwe-mark.png" />
    <!-- The wordmark (widget header) and Geist, the website's typeface (SIL OFL 1.1, see Assets\Fonts\Geist-OFL.txt).
         Regenerate the logo files with design\make_tray_brand.py. -->
    <Resource Include="Assets\zinwe-logo.png" />
    <Resource Include="Assets\zinwe-logo-light.png" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <None Include="Assets\Fonts\Geist-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zinwe.Agent.Core\Zinwe.Agent.Core.csproj" />
  </ItemGroup>

</Project>
