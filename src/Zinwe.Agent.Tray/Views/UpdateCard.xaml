<UserControl x:Class="Zinwe.Agent.Tray.Views.UpdateCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <!-- The update card (Home and Me): an orange 2 px frame; one click downloads, verifies and installs. -->
    <Border CornerRadius="16" Padding="14,12" Background="{DynamicResource Z.Surface}" BorderBrush="{DynamicResource Z.Orange}" BorderThickness="2">
        <StackPanel>
            <TextBlock x:Name="Title" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock x:Name="Body" FontSize="12.5" Foreground="{DynamicResource Z.Ink3}" TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,0" />
            <TextBlock x:Name="Notes" FontSize="12.5" Foreground="{DynamicResource Z.Ink2}" TextWrapping="Wrap" LineHeight="18" Margin="0,6,0,0"
                       MaxHeight="54" TextTrimming="CharacterEllipsis" />
            <ProgressBar x:Name="Bar" Height="6" Margin="0,8,0,0" IsIndeterminate="True" Foreground="{DynamicResource Z.Orange}"
                         Background="{DynamicResource Z.Fill}" BorderThickness="0" AutomationProperties.Name="Update progress" />
            <TextBlock x:Name="Progress" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />
            <WrapPanel Margin="0,4,0,0">
                <Button x:Name="UpdateButton" Style="{StaticResource Z.BtnSm.Pri}" Margin="0,0,8,0" Click="OnUpdate" />
                <Button x:Name="ManualButton" Style="{StaticResource Z.LinkBtn}" Click="OnManual" />
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
