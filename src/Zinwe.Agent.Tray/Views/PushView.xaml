<UserControl x:Class="Zinwe.Agent.Tray.Views.PushView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The screens pushed over a tab (Back arrow in the header): My time, Settings, Notifications, Help, Policies & terms. -->
    <Grid>
        <!-- ===== My time ===== -->
        <ScrollViewer x:Name="TimePanel" Style="{StaticResource Z.Scroll}">
            <StackPanel Margin="12,4,12,16">
                <UniformGrid x:Name="TimeTiles" Columns="2" Margin="-4,-4,-4,8" />
                <Border Style="{StaticResource Z.Card}" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Today" Style="{StaticResource Z.H2}" Margin="0,0,0,4" />
                        <StackPanel x:Name="TimeTimeline" />
                        <TextBlock x:Name="TimeEmpty" Text="Nothing yet today." FontSize="12.5" Foreground="{DynamicResource Z.Muted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Z.Card}" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Last 5 working days" Style="{StaticResource Z.H2}" Margin="0,0,0,10" />
                        <Border BorderBrush="{DynamicResource Z.Line}" BorderThickness="0,0,0,1" Height="110">
                            <UniformGrid x:Name="WeekBars" Rows="1" />
                        </Border>
                        <UniformGrid x:Name="WeekDays" Rows="1" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Z.Note}">
                    <TextBlock x:Name="TimeNote" FontSize="12" Foreground="{DynamicResource Z.Ink2}" TextWrapping="Wrap" LineHeight="18" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Settings ===== -->
        <ScrollViewer x:Name="SettingsPanel" Style="{StaticResource Z.Scroll}" Visibility="Collapsed">
            <StackPanel Margin="12,4,12,16">
                <TextBlock Text="NOTIFICATIONS" Style="{StaticResource Z.Lbl}" Margin="4,4,0,12" />
                <Border Style="{StaticResource Z.Card}" ClipToBounds="True" Margin="0,0,0,12">
                    <StackPanel>
                        <ToggleButton x:Name="NotifyOn" Style="{StaticResource Z.SwitchRow}" Checked="OnToggle" Unchecked="OnToggle" AutomationProperties.Name="Pop-up notifications">
                            <StackPanel>
                                <TextBlock Text="Pop-up notifications" FontWeight="SemiBold" />
                                <TextBlock x:Name="NotifySub" FontSize="12" Foreground="{DynamicResource Z.Muted}" TextWrapping="Wrap" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="DueRemind" Style="{StaticResource Z.SwitchRow}" Checked="OnToggle" Unchecked="OnToggle" AutomationProperties.Name="Due-soon reminders">
                            <StackPanel>
                                <TextBlock Text="Due-soon reminders" FontWeight="SemiBold" />
                                <TextBlock Text="30 minutes before a task is due" FontSize="12" Foreground="{DynamicResource Z.Muted}" TextWrapping="Wrap" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="DayRemind" Style="{StaticResource Z.SwitchRow}" Checked="OnToggle" Unchecked="OnToggle" AutomationProperties.Name="Work-day reminders">
                            <StackPanel>
                                <TextBlock Text="Work-day reminders" FontWeight="SemiBold" />
                                <TextBlock Text="If you forget to start your day, a break runs long, or it’s late" FontSize="12"
                                           Foreground="{DynamicResource Z.Muted}" TextWrapping="Wrap" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </Border>
                <TextBlock Text="ON THIS PC" Style="{StaticResource Z.Lbl}" Margin="4,4,0,12" />
                <Border Style="{StaticResource Z.Card}" Padding="14,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource Z.Bg}" VerticalAlignment="Top" Margin="0,0,12,0">
                            <Path Data="M5 4h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM8 20h8M12 16v4" Stroke="{DynamicResource Z.Ink3}"
                                  StrokeThickness="2" Stretch="Uniform" Width="16" Height="16" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Border>
                        <TextBlock Grid.Column="1" FontSize="12.5" Foreground="{DynamicResource Z.Ink2}" TextWrapping="Wrap" LineHeight="18">
                            <Run Text="Runs with Windows" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource Z.Ink}" /><LineBreak />
                            <Run x:Name="RunsWithWindows" />
                        </TextBlock>
                    </Grid>
                </Border>
                <TextBlock Text="LOOK" Style="{StaticResource Z.Lbl}" Margin="4,4,0,12" />
                <Border Style="{StaticResource Z.Card}" ClipToBounds="True">
                    <StackPanel>
                        <ToggleButton x:Name="DarkMode" Style="{StaticResource Z.SwitchRow}" Checked="OnToggle" Unchecked="OnToggle" AutomationProperties.Name="Dark mode">
                            <StackPanel>
                                <TextBlock Text="Dark mode" FontWeight="SemiBold" />
                                <TextBlock Text="Easier on the eyes in a dim room" FontSize="12" Foreground="{DynamicResource Z.Muted}" />
                            </StackPanel>
                        </ToggleButton>
                        <Grid Margin="14,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Text size" FontWeight="SemiBold" />
                                <TextBlock Text="Makes everything in the panel bigger" FontSize="12" Foreground="{DynamicResource Z.Muted}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1" CornerRadius="9" Background="{DynamicResource Z.Fill}" Padding="3" VerticalAlignment="Center">
                                <UniformGrid Rows="1" AutomationProperties.Name="Text size">
                                    <RadioButton x:Name="SizeStandard" Style="{StaticResource Z.Seg}" GroupName="size" Content="Standard" Checked="OnSize" />
                                    <RadioButton x:Name="SizeLarge" Style="{StaticResource Z.Seg}" GroupName="size" Content="Large" Checked="OnSize" />
                                </UniformGrid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Notifications ===== -->
        <ScrollViewer x:Name="NotifPanel" Style="{StaticResource Z.Scroll}" Visibility="Collapsed">
            <StackPanel Margin="12,4,12,16">
                <Button x:Name="PauseButton" Click="OnPause" Cursor="Hand" FocusVisualStyle="{StaticResource Z.FocusRing}" Margin="0,0,0,12">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="16" Padding="14,12" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Data="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10.3 21a1.9 1.9 0 0 0 3.4 0" Stroke="{DynamicResource Z.Ink}" StrokeThickness="2"
                              Stretch="Uniform" Width="18" Height="18" Margin="0,0,12,0" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="PauseTitle" FontWeight="SemiBold" Foreground="{DynamicResource Z.Ink}" />
                            <TextBlock x:Name="PauseSub" FontSize="12" Foreground="{DynamicResource Z.Muted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Grid x:Name="UnreadRow" Margin="4,0,4,8">
                    <TextBlock x:Name="UnreadLine" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Z.Ink2}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource Z.LinkBtn}" Content="Mark all as read" HorizontalAlignment="Right" Click="OnMarkAll" />
                </Grid>
                <Border Style="{StaticResource Z.Card}" ClipToBounds="True" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel x:Name="NotifList" />
                        <TextBlock x:Name="NoNotifs" Text="No notifications yet today." FontSize="13" Foreground="{DynamicResource Z.Muted}" Margin="14,16" />
                    </StackPanel>
                </Border>
                <TextBlock Text="Zinwe also sends these to the Windows notification centre, so you can find missed ones there." FontSize="12"
                           Foreground="{DynamicResource Z.Muted}" TextWrapping="Wrap" Margin="4,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Help ===== -->
        <ScrollViewer x:Name="HelpPanel" Style="{StaticResource Z.Scroll}" Visibility="Collapsed">
            <StackPanel Margin="12,4,12,16">
                <Border Style="{StaticResource Z.Card}" ClipToBounds="True" Margin="0,0,0,12">
                    <StackPanel x:Name="HelpList" />
                </Border>
                <Border Style="{StaticResource Z.Note}">
                    <StackPanel>
                        <TextBlock Text="Keyboard shortcut" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource Z.Ink2}" />
                        <TextBlock FontSize="12.5" Foreground="{DynamicResource Z.Ink2}" TextWrapping="Wrap" Margin="0,4,0,0">
                            <Run Text="Ctrl+Alt+Z" FontFamily="{DynamicResource Z.Mono}" /><Run Text=" opens Zinwe or minimizes it to the taskbar." />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Policies & terms ===== -->
        <Grid x:Name="PrivacyPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Margin="12,4,12,8" CornerRadius="9" Background="{DynamicResource Z.Fill}" Padding="3">
                <UniformGrid Rows="1" AutomationProperties.Name="Policies and terms">
                    <RadioButton x:Name="TabPc" Style="{StaticResource Z.Seg}" GroupName="ptab" Content="On this PC" Tag="pc" Checked="OnPrivacyTab" />
                    <RadioButton x:Name="TabRights" Style="{StaticResource Z.Seg}" GroupName="ptab" Content="Your rights" Tag="rights" Checked="OnPrivacyTab" />
                    <RadioButton x:Name="TabFair" Style="{StaticResource Z.Seg}" GroupName="ptab" Content="Fair use" Tag="fair" Checked="OnPrivacyTab" />
                    <RadioButton x:Name="TabTerms" Style="{StaticResource Z.Seg}" GroupName="ptab" Content="Terms" Tag="terms" Checked="OnPrivacyTab" />
                </UniformGrid>
            </Border>
            <ScrollViewer x:Name="PrivacyScroller" Grid.Row="1" Style="{StaticResource Z.Scroll}">
                <StackPanel Margin="12,0,12,16">
                    <Border Style="{StaticResource Z.Card}" Padding="14" Margin="0,0,0,12">
                        <StackPanel x:Name="PolicyBody" TextBlock.FontSize="13" />
                    </Border>
                    <Border Style="{StaticResource Z.Card}" Padding="14,12">
                        <StackPanel>
                            <TextBlock x:Name="ConsentLine" FontSize="12.5" TextWrapping="Wrap" />
                            <Button x:Name="ConsentButton" HorizontalAlignment="Left" Margin="0,6,0,0" Click="OnConsentButton" />
                            <Border x:Name="WithdrawConfirm" CornerRadius="10" Padding="12,10" Margin="0,10,0,0" Background="{DynamicResource Z.RedTint}"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="WithdrawText" FontSize="12.5" Foreground="{DynamicResource Z.RedInk}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Button Style="{StaticResource Z.BtnSm.Dark}" Content="Withdraw" Click="OnWithdraw" />
                                        <Button Style="{StaticResource Z.BtnSm}" Content="Keep my agreement" Margin="8,0,0,0" Click="OnKeep" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
