<UserControl x:Class="Zinwe.Agent.Tray.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Chat: date lines, the owner's avatar on the last bubble of a run, "Reply" as plain text, task cards, on the
        background picked in Chat options. Theirs are white bubbles with a hairline, yours the orange tint. The composer:
        ⚡ quick replies (star three for the row above it), the message, 🙂 emoji, send.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="ConnectionNote" Margin="12,0,12,6" CornerRadius="10" Padding="12,8" Background="{DynamicResource Z.WarnTint}"
                Visibility="Collapsed">
            <TextBlock x:Name="ConnectionText" FontSize="12" Foreground="{DynamicResource Z.WarnInk}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>
        <ScrollViewer x:Name="Scroller" Grid.Row="1" Style="{StaticResource Z.Scroll}" ScrollChanged="OnScrollChanged">
            <StackPanel x:Name="Log" Margin="12,4,12,0" AutomationProperties.Name="Chat" AutomationProperties.LiveSetting="Polite" />
        </ScrollViewer>
        <TextBlock x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" Margin="28,0" FontSize="12.5" Foreground="{DynamicResource Z.Muted}" Visibility="Collapsed" />
        <Button x:Name="JumpButton" Grid.Row="1" Style="{StaticResource Z.JumpBtn}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,10" Click="OnJump" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="JumpText" VerticalAlignment="Center" />
                <Path Data="M12 5v14M6 13l6 6 6-6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform"
                      Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <Border Grid.Row="2" Background="{DynamicResource Z.Surface}" BorderBrush="{DynamicResource Z.Line}" BorderThickness="0,1,0,0"
                Padding="12,4,12,12">
            <StackPanel>
                <Border x:Name="QuickHost" Height="0" Opacity="0" ClipToBounds="True">
                    <!-- The starred quick replies (at most three). F-08: a bar shows when they run wider than the window. -->
                    <ScrollViewer x:Name="QuickScroll" Style="{StaticResource Z.ScrollX}" PreviewMouseWheel="OnQuickWheel" VerticalAlignment="Center">
                        <StackPanel x:Name="QuickRow" Orientation="Horizontal" AutomationProperties.Name="Favourite quick replies" />
                    </ScrollViewer>
                </Border>
                <!-- ⚡ in the composer: every quick reply, a star puts it in the row. -->
                <Border x:Name="QuickPanel" Margin="0,8,0,4" CornerRadius="12" BorderThickness="1" Padding="6,8"
                        BorderBrush="{DynamicResource Z.Line}" Background="{DynamicResource Z.Surface}" Visibility="Collapsed"
                        AutomationProperties.Name="Quick replies">
                    <StackPanel>
                        <DockPanel Margin="6,0,6,4" LastChildFill="False">
                            <TextBlock Text="Quick replies" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource Z.Ink}" />
                            <TextBlock DockPanel.Dock="Right" Text="Star up to 3 for the row" FontSize="11.5" Foreground="{DynamicResource Z.Muted}"
                                       VerticalAlignment="Bottom" />
                        </DockPanel>
                        <StackPanel x:Name="QuickList" KeyboardNavigation.TabNavigation="Continue" />
                        <TextBlock x:Name="QuickNoteText" FontSize="12" Foreground="{DynamicResource Z.OrangeInk}" Margin="8,4,8,0"
                                   Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
                <!-- 🙂 in the composer: a few emoji, added where the member is typing. -->
                <Border x:Name="EmojiPanel" Margin="0,8,0,4" CornerRadius="12" BorderThickness="1" Padding="8"
                        BorderBrush="{DynamicResource Z.Line}" Background="{DynamicResource Z.Surface}" Visibility="Collapsed"
                        AutomationProperties.Name="Emoji">
                    <UniformGrid x:Name="EmojiGrid" Columns="8" />
                </Border>
                <Border x:Name="ReplyBar" CornerRadius="8" Background="{DynamicResource Z.Fill}" Padding="12,4,4,4" Margin="0,4,0,4" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ReplyWho" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Z.Ink}" />
                            <TextBlock x:Name="ReplyText" FontSize="12" Foreground="{DynamicResource Z.Ink2}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Z.IconBtn}" Width="34" Height="34" Content="×" FontSize="18"
                                AutomationProperties.Name="Cancel reply" Click="OnCancelReply" />
                    </Grid>
                </Border>
                <!-- v1.5: the picked file, as a chip (name, size, ✕); the text typed becomes its caption. -->
                <ContentControl x:Name="AttachHost" Focusable="False" Visibility="Collapsed" />
                <!-- Composer -->
                <Border x:Name="Composer" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Z.Line2}" Background="{DynamicResource Z.Surface}"
                        Padding="6" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="QuickButton" Style="{StaticResource Z.ComposerBtn}" Margin="0,0,4,0" VerticalAlignment="Bottom"
                                AutomationProperties.Name="Quick replies" ToolTip="Quick replies" Click="OnQuickButton">
                            <Grid Width="38" Height="38">
                                <Path x:Name="QuickGlyph" Data="M13 3 5 13.5h6L10 21l8-10.5h-6z" StrokeThickness="2" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="17" Height="17" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource Z.Muted}" />
                                <!-- The row of starred replies is showing: a small dot says the full list is here. -->
                                <Ellipse x:Name="QuickHint" Width="6" Height="6" Fill="{DynamicResource Z.Orange}" HorizontalAlignment="Right"
                                         VerticalAlignment="Top" Margin="0,6,6,0" Visibility="Collapsed" IsHitTestVisible="False" />
                            </Grid>
                        </Button>
                        <TextBox x:Name="Input" Grid.Column="1" BorderThickness="0" Background="Transparent" MinHeight="38" MaxHeight="110"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="2000"
                                 VerticalContentAlignment="Center" Padding="0,9" FontSize="14" Foreground="{DynamicResource Z.Ink}"
                                 CaretBrush="{DynamicResource Z.Ink}" FocusVisualStyle="{x:Null}"
                                 PreviewKeyDown="OnInputKeyDown" TextChanged="OnInputChanged" GotKeyboardFocus="OnInputFocus" LostKeyboardFocus="OnInputFocus">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Grid Margin="{TemplateBinding Padding}">
                                        <TextBlock x:Name="ph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                   Foreground="{DynamicResource Z.Muted}" IsHitTestVisible="False" Visibility="Collapsed"
                                                   VerticalAlignment="Center" Margin="2,0,0,0" TextTrimming="CharacterEllipsis" FontSize="13" />
                                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                                      Template="{StaticResource Zinwe.InputScroll}" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter TargetName="ph" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                        <Button x:Name="EmojiButton" Grid.Column="2" Style="{StaticResource Z.ComposerBtn}" VerticalAlignment="Bottom"
                                AutomationProperties.Name="Emoji" ToolTip="Emoji" Click="OnEmojiButton">
                            <Path x:Name="EmojiGlyph" Data="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM8.5 14.5c.9 1.3 2.1 2 3.5 2s2.6-.7 3.5-2M9 9.5h.01M15 9.5h.01"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18"
                                  Stretch="Uniform" Stroke="{DynamicResource Z.Muted}" />
                        </Button>
                        <!-- v1.5: attach a file (hidden while file sharing is off, or on an older backend). -->
                        <Button x:Name="AttachButton" Grid.Column="3" Style="{StaticResource Z.ComposerBtn}" VerticalAlignment="Bottom"
                                AutomationProperties.Name="Attach a file" ToolTip="Attach a file" Click="OnAttach" Visibility="Collapsed">
                            <Path x:Name="AttachGlyph" Data="m21 11-8.6 8.6a5 5 0 0 1-7-7l8.6-8.6a3.3 3.3 0 0 1 4.7 4.7l-8.6 8.6a1.7 1.7 0 0 1-2.4-2.4L15 7.6"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18"
                                  Stretch="Uniform" Stroke="{DynamicResource Z.Muted}" />
                        </Button>
                        <Button x:Name="SendButton" Grid.Column="4" Style="{StaticResource Z.SendBtn}" VerticalAlignment="Bottom" Margin="6,0,0,0" Click="OnSend"
                                AutomationProperties.Name="Send" IsEnabled="False">
                            <Path x:Name="SendGlyph" Data="M12 19V5M6 11l6-6 6 6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16"
                                  Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>
                <TextBlock x:Name="SendError" FontSize="12" Foreground="{DynamicResource Z.RedText}" Margin="0,4,0,0" Visibility="Collapsed"
                           AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
