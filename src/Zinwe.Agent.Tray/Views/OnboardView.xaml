<UserControl x:Class="Zinwe.Agent.Tray.Views.OnboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- First run and setup states: Connect this PC, the consent question, You're all set, removed, not running. -->
    <Grid>
        <!-- ===== Connect this PC ===== -->
        <Grid x:Name="ConnectPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer Style="{StaticResource Z.Scroll}">
                <StackPanel Margin="16,12,16,16">
                    <StackPanel Margin="4,18,4,14">
                        <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource Z.Orange}" HorizontalAlignment="Left">
                            <TextBlock Text="Z" FontSize="26" FontWeight="ExtraBold" Foreground="{DynamicResource Z.OnOrange}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="ConnectTitle" Text="Connect this PC" FontSize="22" FontWeight="Bold" Margin="0,14,0,0" />
                        <TextBlock Text="Enter your work email and the Member ID from the invite email your admin sent you."
                                   Foreground="{DynamicResource Z.Ink3}" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0" />
                    </StackPanel>
                    <Border Style="{StaticResource Z.Card}" Padding="14">
                        <StackPanel>
                            <Label Content="Work email" Target="{Binding ElementName=EmailInput}" Padding="0" FontWeight="SemiBold" FontSize="12.5"
                                   Foreground="{DynamicResource Z.Ink}" />
                            <TextBox x:Name="EmailInput" Style="{StaticResource Z.Input}" Tag="you@company.com" Margin="0,8,0,0"
                                     AutomationProperties.Name="Work email" TextChanged="OnConnectInput" />
                            <Label Content="Member ID" Target="{Binding ElementName=MemberIdInput}" Padding="0" FontWeight="SemiBold" FontSize="12.5"
                                   Margin="0,12,0,0" Foreground="{DynamicResource Z.Ink}" />
                            <TextBox x:Name="MemberIdInput" Style="{StaticResource Z.Input}" Tag="ZM-XXXX-XXXX" Margin="0,8,0,0"
                                     FontFamily="{DynamicResource Z.Mono}" CharacterCasing="Upper"
                                     AutomationProperties.Name="Member ID" AutomationProperties.HelpText="Spaces, dashes and capitals don't matter."
                                     TextChanged="OnConnectInput" />
                            <TextBlock Text="Spaces, dashes and capitals don't matter." FontSize="12" Foreground="{DynamicResource Z.Muted}" Margin="0,8,0,0" />
                            <TextBlock x:Name="ConnectMessage" FontSize="12.5" FontWeight="Medium" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Z.Note}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Quickest way" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource Z.Ink2}" />
                            <TextBlock FontSize="12.5" Foreground="{DynamicResource Z.Ink2}" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,0">
                                Open the invite email on this PC and click <Bold>Connect this PC</Bold>. Zinwe fills in both boxes for you.
                            </TextBlock>
                            <TextBlock Text="Can't find your Member ID?" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource Z.Ink2}" Margin="0,8,0,0" />
                            <TextBlock Text="Ask your manager or IT admin to resend your Zinwe invite. It comes from no-reply@zinwe.io."
                                       FontSize="12.5" Foreground="{DynamicResource Z.Ink2}" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" Background="{DynamicResource Z.Surface}" BorderBrush="{DynamicResource Z.Line}" BorderThickness="0,1,0,0"
                    Padding="16,12,16,16">
                <Button x:Name="ConnectButton" Style="{StaticResource Z.Btn.Pri}" MinHeight="46" Content="Connect" IsDefault="True" Click="OnConnect" />
            </Border>
        </Grid>

        <!-- ===== The consent question ===== -->
        <Grid x:Name="ConsentPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="ConsentScroller" Style="{StaticResource Z.Scroll}">
                <StackPanel Margin="16,8,16,16" TextBlock.FontSize="13">
                    <StackPanel Margin="4,8,4,12">
                        <TextBlock Text="ONE QUESTION FIRST" Style="{StaticResource Z.Lbl}" />
                        <TextBlock Text="Before Zinwe starts on this PC" FontSize="21" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock x:Name="ConsentIntro" Foreground="{DynamicResource Z.Ink3}" TextWrapping="Wrap" LineHeight="19.5" Margin="0,0,0,12" />
                    <Border Style="{StaticResource Z.Card}" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="SeesHeading" FontWeight="Bold" />
                            <StackPanel x:Name="SeesList" Margin="0,8,0,0" />
                            <TextBlock x:Name="SeesMore" FontSize="12" Foreground="{DynamicResource Z.Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Z.Card}" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="NeverHeading" FontWeight="Bold" />
                            <StackPanel x:Name="NeverList" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource Z.LinkBtn}" Content="Read the full Privacy Policy" MinHeight="44" Click="OnPrivacyPolicy" />
                    <TextBlock Text="It stays one tap away afterwards, under Me › Policies &amp; terms, where you can also withdraw."
                               FontSize="12" Foreground="{DynamicResource Z.Muted}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Border Style="{StaticResource Z.Card}" Padding="14">
                        <StackPanel>
                            <TextBlock x:Name="DeclineHeading" FontWeight="Bold" />
                            <TextBlock x:Name="DeclineBody" Foreground="{DynamicResource Z.Ink2}" TextWrapping="Wrap" LineHeight="19.5" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" Background="{DynamicResource Z.Surface}" BorderBrush="{DynamicResource Z.Line}" BorderThickness="0,1,0,0"
                    Padding="16,12,16,14">
                <StackPanel>
                    <TextBlock x:Name="ConsentFooter" FontSize="12" Foreground="{DynamicResource Z.Ink3}" TextWrapping="Wrap" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AgreeButton" Style="{StaticResource Z.Btn.Pri}" Content="I agree" Click="OnAgree" />
                        <Button Grid.Column="2" Style="{StaticResource Z.Btn}" Content="I don't agree" Click="OnDecline" />
                    </Grid>
                    <Button Style="{StaticResource Z.LinkBtn}" Content="Not now" HorizontalAlignment="Center" FontSize="12" FontWeight="Normal"
                            Foreground="{DynamicResource Z.Ink3}" MinHeight="44" Margin="0,4,0,0" Click="OnNotNow" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== You're all set / You're connected ===== -->
        <Grid x:Name="WelcomePanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer Style="{StaticResource Z.Scroll}">
                <StackPanel Margin="16,24,16,16">
                    <Border x:Name="WelcomeIcon" Width="52" Height="52" CornerRadius="14" HorizontalAlignment="Left">
                        <Path x:Name="WelcomeTick" Data="M20,6 L9,17 L4,12" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Width="26" Height="26" Stretch="None" Margin="1,3,0,0" />
                    </Border>
                    <TextBlock x:Name="WelcomeTitle" FontSize="22" FontWeight="Bold" Margin="0,14,0,0" />
                    <TextBlock x:Name="WelcomeBody" Foreground="{DynamicResource Z.Ink3}" TextWrapping="Wrap" LineHeight="20" Margin="0,14,0,14" />
                    <Border x:Name="TipsCard" Style="{StaticResource Z.Card}">
                        <StackPanel x:Name="Tips" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" Background="{DynamicResource Z.Surface}" BorderBrush="{DynamicResource Z.Line}" BorderThickness="0,1,0,0"
                    Padding="16,12,16,16">
                <Button Style="{StaticResource Z.Btn.Pri}" MinHeight="46" Content="Start using Zinwe" Click="OnStartApp" />
            </Border>
        </Grid>

        <!-- ===== Removed by the owner ===== -->
        <Grid x:Name="RemovedPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="16,24,16,16">
                <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource Z.Fill}" HorizontalAlignment="Left">
                    <Path Data="M3,4 H21 V16 H3 Z M8,20 H16 M12,16 V20 M9,8 L15,12 M15,8 L9,12" Stroke="{DynamicResource Z.Muted}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24" Stretch="None" />
                </Border>
                <TextBlock x:Name="RemovedTitle" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" Margin="0,12,0,0" />
                <TextBlock Text="Monitoring has stopped and your company's rules no longer apply on this PC. Nothing new is recorded. If you were sent a new Member ID, connect again."
                           Foreground="{DynamicResource Z.Ink3}" TextWrapping="Wrap" LineHeight="20" Margin="0,12,0,0" />
            </StackPanel>
            <Border Grid.Row="1" Background="{DynamicResource Z.Surface}" BorderBrush="{DynamicResource Z.Line}" BorderThickness="0,1,0,0"
                    Padding="16,12,16,16">
                <Button Style="{StaticResource Z.Btn.Pri}" MinHeight="46" Content="Connect with a new Member ID" Click="OnReconnect" />
            </Border>
        </Grid>

        <!-- ===== Zinwe isn't running (never set up for this person) ===== -->
        <StackPanel x:Name="NotRunningPanel" Visibility="Collapsed" Margin="16,24,16,16">
            <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource Z.RedTint}" HorizontalAlignment="Left">
                <TextBlock Text="!" FontSize="24" FontWeight="ExtraBold" Foreground="{DynamicResource Z.RedText}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="NotRunningTitle" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" Margin="0,12,0,0" />
            <TextBlock x:Name="NotRunningBody" Foreground="{DynamicResource Z.Ink3}" TextWrapping="Wrap" LineHeight="20" Margin="0,12,0,14"
                       AutomationProperties.LiveSetting="Assertive" />
            <Button x:Name="RetryButton" Style="{StaticResource Z.Btn}" HorizontalAlignment="Left" Content="Try again" Click="OnRetry" />
        </StackPanel>
    </Grid>
</UserControl>
