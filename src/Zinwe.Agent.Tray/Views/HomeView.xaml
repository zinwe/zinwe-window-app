<UserControl x:Class="Zinwe.Agent.Tray.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <!-- Home: the update card, "monitoring is off", Needs you, Today so far. -->
    <ScrollViewer Style="{StaticResource Z.Scroll}">
        <StackPanel Margin="12,4,12,16">
            <ContentControl x:Name="UpdateHost" Focusable="False" />

            <Border x:Name="DeclinedNote" CornerRadius="12" Padding="12,6,12,6" Background="{DynamicResource Z.WarnTint}" Margin="0,0,0,12"
                    Visibility="Collapsed">
                <WrapPanel>
                    <TextBlock Text="Monitoring is off on this PC." FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource Z.WarnInk}"
                               VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock Text="Nothing about what you do is recorded." FontSize="12.5" Foreground="{DynamicResource Z.WarnInk}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button Style="{StaticResource Z.LinkBtn}" Content="Review" Foreground="{DynamicResource Z.WarnInk}" Click="OnReview" />
                </WrapPanel>
            </Border>

            <Border Style="{StaticResource Z.Card}" Margin="0,0,0,12" ClipToBounds="True">
                <StackPanel>
                    <Grid Margin="14,12,14,6">
                        <TextBlock Text="Needs you" Style="{StaticResource Z.H2}" />
                        <TextBlock x:Name="NeedsCount" FontSize="12" Foreground="{DynamicResource Z.Muted}" HorizontalAlignment="Right" />
                    </Grid>
                    <StackPanel x:Name="NeedsList" />
                    <TextBlock x:Name="NoNeeds" Text="You're all caught up." FontSize="13" Foreground="{DynamicResource Z.Muted}" Margin="14,4,14,14" />
                </StackPanel>
            </Border>

            <Border x:Name="TodayCard" Style="{StaticResource Z.Card}" Padding="14,12">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Today so far" Style="{StaticResource Z.H2}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource Z.LinkBtn}" Content="My time" HorizontalAlignment="Right" Click="OnMyTime" />
                    </Grid>
                    <StackPanel x:Name="Timeline" Margin="0,2,0,0" />
                    <TextBlock x:Name="NoTimeline" Text="Nothing yet. Press Start day when you begin work." FontSize="12.5"
                               Foreground="{DynamicResource Z.Muted}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border x:Name="ProtectedCard" Style="{StaticResource Z.Card}" Padding="14,12" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="This PC is protected" Style="{StaticResource Z.H2}" />
                    <TextBlock Text="Zinwe is running and your company's rules apply. There's nothing you need to do here." FontSize="12.5"
                               Foreground="{DynamicResource Z.Ink3}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
