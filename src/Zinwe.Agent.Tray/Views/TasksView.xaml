<UserControl x:Class="Zinwe.Agent.Tray.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tasks: Todo (overdue and today) + Status, Date and From dropdowns; groups Doing / To do / With {owner} / Done for the owner's tasks, then My to-dos (this PC only). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="12,4,12,0" AutomationProperties.Name="Filter tasks">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="TodoButton" Style="{StaticResource Z.TodoBtn}" Margin="0,0,6,0" Click="OnTodo">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Todo" VerticalAlignment="Center" />
                    <TextBlock x:Name="TodoCount" Margin="5,0,0,0" FontWeight="Bold" Opacity="0.75" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>
            <Grid x:Name="Filters" Grid.Column="1" Margin="0,0,-6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
            </Grid>
        </Grid>
        <Grid Grid.Row="1" Margin="14,0,14,0" MinHeight="28">
            <TextBlock x:Name="ResultText" FontSize="12" Foreground="{DynamicResource Z.Muted}" VerticalAlignment="Center" />
            <Button x:Name="ClearLink" Style="{StaticResource Z.LinkBtn}" MinHeight="28" FontSize="12" Content="Clear filters" HorizontalAlignment="Right" Click="OnClear"
                    Visibility="Collapsed" />
        </Grid>
        <ScrollViewer Grid.Row="2" x:Name="ListScroller" Style="{StaticResource Z.Scroll}">
            <StackPanel Margin="12,0,12,12">
                <StackPanel x:Name="Groups" />
                <StackPanel x:Name="Empty" Margin="6,24,6,16" Visibility="Collapsed">
                    <TextBlock x:Name="EmptyText" Foreground="{DynamicResource Z.Muted}" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource Z.Btn}" Margin="0,4,0,0" Click="OnAdd" AutomationProperties.Name="Add a to-do">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M12 5v14M5 12h14" Stroke="{DynamicResource Z.Ink}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Add a to-do" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
