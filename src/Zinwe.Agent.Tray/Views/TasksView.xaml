<UserControl x:Class="Zinwe.Agent.Tray.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Tasks (F-16, the owner-approved prototype tasks-v2): the filters in one full-width row (All with its calendar,
        Today, Upcoming, Done with its status menu), the line of the filter in force, then every task under a dated
        heading that stays at the top while its tasks scroll. A floating + above the tab bar adds a to-do. Content is
        black and greys; orange marks only what needs a look.
    -->
    <Grid x:Name="Layout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- The filters, full width: the selected one black with white text, the others outlined. -->
        <Grid x:Name="Segs" Margin="12,12,12,2" AutomationProperties.Name="Show">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        </Grid>
        <!-- "Due on Thursday 5 November ×" / "Status: Doing ×" while a filter is on. -->
        <StackPanel x:Name="FilterLine" Grid.Row="1" Orientation="Horizontal" Margin="14,8,14,0" Visibility="Collapsed" />

        <Grid Grid.Row="2">
            <ScrollViewer x:Name="ListScroller" Style="{StaticResource Z.Scroll}" ScrollChanged="OnListScrolled">
                <!-- Bottom padding so the last task clears the floating +. -->
                <StackPanel Margin="12,0,12,84">
                    <StackPanel x:Name="Empty" Margin="16,40,16,16" Visibility="Collapsed">
                        <TextBlock x:Name="EmptyTitle" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Z.Ink}" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,0,2" />
                        <TextBlock x:Name="EmptyText" FontSize="13" Foreground="{DynamicResource Z.Muted}" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="Rows" />
                </StackPanel>
            </ScrollViewer>
            <!-- The heading of the section at the top of the list, pinned while its tasks scroll under it. -->
            <Border x:Name="Pinned" VerticalAlignment="Top" Margin="12,0,20,0" Background="{DynamicResource Z.Surface}" Visibility="Collapsed"
                    IsHitTestVisible="False" />
        </Grid>

        <!-- Floating Add: round, black, above the tab bar; it moves up while the snack bar shows. -->
        <Button x:Name="AddButton" Grid.RowSpan="3" Width="52" Height="52" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,14,14" Cursor="Hand" Click="OnAdd" Panel.ZIndex="4" AutomationProperties.Name="Add a to-do" ToolTip="Add a to-do"
                >
            <Button.FocusVisualStyle>
                <Style>
                    <Setter Property="Control.Template">
                        <Setter.Value>
                            <ControlTemplate>
                                <Ellipse Margin="-3" Stroke="{DynamicResource Z.Focus}" StrokeThickness="2" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.FocusVisualStyle>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="g" RenderTransformOrigin="0.5,0.5">
                        <Ellipse Fill="{DynamicResource Z.Inv}">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.28" Direction="270" Color="#141210" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Path Data="M10,3.5 L10,16.5 M3.5,10 L16.5,10" Stroke="{DynamicResource Z.OnInv}" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20" HorizontalAlignment="Center"
                              VerticalAlignment="Center" />                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="g" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.04" ScaleY="1.04" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="g" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- The calendar on All and the status menu on Done: under the filters; a click elsewhere in the list closes them. -->
        <Border x:Name="PopCatcher" Grid.Row="1" Grid.RowSpan="2" Background="Transparent" Panel.ZIndex="6" Visibility="Collapsed"
                MouseDown="OnPopCatcher" />
        <ContentControl x:Name="PopSlot" Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="7" Focusable="False" VerticalAlignment="Top" />
    </Grid>
</UserControl>
