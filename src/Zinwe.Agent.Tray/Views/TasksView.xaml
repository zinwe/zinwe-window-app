<UserControl x:Class="Zinwe.Agent.Tray.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Tasks v1.4 (prototype WinApp board, member side): a grey rounded "Search tasks" field and an orange "+ Add" pill
        (Add a to-do; no floating button), the pill chips All · Today · Upcoming · Done with their counts, then the cards
        under "Needs you" and "Waiting" (Done: "Done") on a light grey ground. A card opens the member task panel.
    -->
    <Grid x:Name="Layout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="12,10,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Search" Style="{StaticResource Z.TvSearch}" Tag="Search tasks" AutomationProperties.Name="Search tasks"
                     TextChanged="OnSearch" />
            <Button x:Name="AddButton" Grid.Column="1" Margin="8,0,0,0" Click="OnAdd" AutomationProperties.Name="Add a to-do" ToolTip="Add a to-do"
                    Style="{StaticResource Z.TvBare}">
                <!-- .zw-padd: 38 px, a true pill (half the height as the corner), with its soft orange glow. -->
                <Border CornerRadius="19" Background="{DynamicResource Z.Orange}" Height="38" Padding="14,0,16,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="5" Direction="270" Opacity="0.45" Color="#F26A0A" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M12 5v14M5 12h14" Stroke="{DynamicResource Z.OnOrange}" StrokeThickness="2.6" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Add" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Z.OnOrange}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Button>
        </Grid>
        <!-- One line of chips that never wraps or clips: with bigger text it scrolls sideways (the wheel too). -->
        <ScrollViewer x:Name="ChipScroll" Grid.Row="1" Margin="12,8,12,8" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                      Focusable="False" PanningMode="HorizontalOnly" PreviewMouseWheel="OnChipWheel">
            <StackPanel x:Name="Chips" Orientation="Horizontal" AutomationProperties.Name="Show" />
        </ScrollViewer>

        <Grid Grid.Row="2" Background="{DynamicResource Z.Fill}">
            <ScrollViewer x:Name="ListScroller" Style="{StaticResource Z.Scroll}">
                <StackPanel Margin="12,0,12,20">
                    <StackPanel x:Name="Empty" Margin="16,40,16,16" Visibility="Collapsed">
                        <TextBlock x:Name="EmptyTitle" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Z.Ink}" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,0,2" />
                        <TextBlock x:Name="EmptyText" FontSize="13" Foreground="{DynamicResource Z.Muted}" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="Rows" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
