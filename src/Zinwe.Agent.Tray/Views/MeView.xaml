<UserControl x:Class="Zinwe.Agent.Tray.Views.MeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <!-- Me: profile, My time · Notifications · Settings · Policies & terms · Help · Send feedback, the update card, version. -->
    <ScrollViewer Style="{StaticResource Z.Scroll}">
        <StackPanel Margin="12,4,12,16">
            <Border Style="{StaticResource Z.Card}" Padding="14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="AvatarButton" Width="46" Height="46" Margin="0,0,12,0" VerticalAlignment="Center" Cursor="Hand"
                            AutomationProperties.Name="Change photo" ToolTip="Change photo" Click="OnPhoto"
                            FocusVisualStyle="{StaticResource Z.FocusRing}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <ContentControl x:Name="AvatarHost" />
                            <Border Width="20" Height="20" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"
                                    Background="{DynamicResource Z.Inv}" BorderBrush="{DynamicResource Z.Surface}" BorderThickness="2">
                                <Path Data="M4 8h3l2-3h6l2 3h3v11H4zM12 9.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7z" Stroke="{DynamicResource Z.OnInv}"
                                      StrokeThickness="1.6" Stretch="Uniform" Width="10" Height="10" StrokeLineJoin="Round" />
                            </Border>
                        </Grid>
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="NameText" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource Z.Muted}" TextTrimming="CharacterEllipsis">
                            <Run x:Name="CompanyRun" /><Run Text=" · " /><Run x:Name="PcRun" FontFamily="{DynamicResource Z.Mono}" />
                        </TextBlock>
                        <Button Style="{StaticResource Z.LinkBtn}" Content="Change photo" Click="OnPhoto" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource Z.Card}" ClipToBounds="True" Margin="0,0,0,12">
                <StackPanel x:Name="Items" />
            </Border>
            <ContentControl x:Name="UpdateHost" Focusable="False" />
            <StackPanel Margin="6,0">
                <TextBlock x:Name="ShortcutLine" FontSize="12" Foreground="{DynamicResource Z.Muted}">
                    <Run Text="Ctrl+Alt+Z" FontFamily="{DynamicResource Z.Mono}" /><Run Text=" opens or minimizes Zinwe" />
                </TextBlock>
                <TextBlock x:Name="VersionLine" FontSize="12" FontFamily="{DynamicResource Z.Mono}" Foreground="{DynamicResource Z.Muted}" Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
